<?xml version="1.0" encoding="utf-8"?>
<!-- ✓ que se dibuja solo (confirmación visible al terminar de guardar, PROPUESTA #12).
     Mismo trazo que ic_check (Material Symbols Rounded, peso 400). Sin animar muestra el ✓ completo. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:name="check" android:fillColor="#00000000" android:strokeColor="#FF000000"
                android:strokeWidth="2" android:strokeLineCap="round" android:strokeLineJoin="round"
                android:trimPathEnd="1" android:pathData="M5.29,12.3 L9.556,16.569 L18.725,7.4"/>
        </vector>
    </aapt:attr>
    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:valueType="floatType" android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>
