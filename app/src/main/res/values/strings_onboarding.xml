    <!--
      Guía del ahorro de batería propio de cada marca. Los nombres de los menús son los que esos teléfonos muestran en
      inglés cuando se conocen; si no, la opción se describe por lo que hace. Cada paso: una frase con punto final y de
      110 letras como mucho. %1$s: la marca (vivo, Xiaomi…) o el botón «Open Verbapp settings».
    -->
    <string name="bat_guide_title">One more %1$s setting</string>
    <string name="bat_guide_body">%1$s has its own battery saver, separate from Android\'s. Without this setting, it may pause your transcriptions when you lock the phone.</string>
    <string name="bat_search_tip">Can\'t find it? In Settings, tap the search icon and look for “background”.</string>
    <string name="bat_open_settings">Open Verbapp settings</string>
    <string name="bat_step_open">Tap “%1$s” below.</string>
    <string name="bat_find_app">Find Verbapp.</string>
    <string name="bat_vivo_battery">Open “Battery” (or “Power consumption”).</string>
    <string name="bat_vivo_allow">Choose the option that allows background power use.</string>
    <string name="bat_vivo_autostart">If you see “Autostart”, turn it on too.</string>
    <string name="bat_vivo_old_path">Open Settings → Battery → “Background power consumption management”.</string>
    <string name="bat_vivo_old_allow">Allow Verbapp to use power in the background.</string>
    <string name="bat_xiaomi_saver">Open “Battery saver” and choose “No restrictions”.</string>
    <string name="bat_xiaomi_autostart">Turn on “Autostart”.</string>
    <string name="bat_huawei_path">Open Settings → Battery → “App launch”.</string>
    <string name="bat_huawei_manual">Find Verbapp and turn off “Manage automatically”.</string>
    <string name="bat_huawei_background">Keep “Run in background” turned on.</string>
    <string name="bat_oppo_usage">Open “Battery usage”.</string>
    <string name="bat_oppo_allow">Turn on “Allow background activity” and “Allow auto launch”.</string>
    <!-- La misma guía en una línea, para «Trabajar con la pantalla bloqueada» (RecordingActions.allowBackground). -->
    <string name="bat_hint_vivo">On %1$s phones, also: Settings → Apps → Verbapp → Battery → allow background power use. If you don\'t see it, search for “background” in Settings.</string>
    <string name="bat_hint_vivo_old">On %1$s phones, also: Settings → Battery → Background power consumption management → Verbapp → allow background power use.</string>
    <string name="bat_hint_xiaomi">On %1$s phones, also: Settings → Apps → Verbapp → Battery saver → No restrictions, and turn on “Autostart”.</string>
    <string name="bat_hint_samsung">On %1$s phones, also: Settings → Apps → Verbapp → Battery → Unrestricted.</string>
    <string name="bat_hint_huawei">On %1$s phones, also: Settings → Battery → App launch → Verbapp → Manage manually, and turn on “Run in background”.</string>
    <string name="bat_hint_oppo">On %1$s phones, also: Settings → Apps → Verbapp → Battery usage → Allow background activity.</string>

