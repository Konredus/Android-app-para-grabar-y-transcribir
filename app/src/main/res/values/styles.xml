<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1859DC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F5F7FC</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#91B6FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1B2230</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#10141D</item>
        <item name="android:colorBackground">#1B2230</item>
        <item name="android:textColorPrimary">#F3F5FA</item>
        <item name="android:textColorSecondary">#ADB8CB</item>
    </style>
</resources>
