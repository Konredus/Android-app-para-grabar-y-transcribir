<resources>
    <!-- Colores base de Verbapp (0.7.0): deben coincidir con AppTheme.Palette (docs/diseno/CRITERIOS.md). -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#2F6B58</item>
        <item name="android:colorControlActivated">#2F6B58</item>
        <item name="android:textColorHighlight">#402F6B58</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#111714</item>
        <item name="android:textColorSecondary">#4F5D57</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#93D4BA</item>
        <item name="android:colorControlActivated">#93D4BA</item>
        <item name="android:textColorHighlight">#4093D4BA</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FF0D1311</item>
        <item name="android:colorBackground">#FF19211E</item>
        <item name="android:textColorPrimary">#E1EAE6</item>
        <item name="android:textColorSecondary">#B4C3BC</item>
    </style>
</resources>
